# Which engine generates names.
#   local     — the in-browser blender. The default; needs nothing configured.
#   deepseek  — calls the backend route below, which holds the DeepSeek key.
VITE_ARCHIS_ENGINE=local

# Where the deepseek engine POSTs. Same-origin by default.
#
# This must be YOUR endpoint, not api.deepseek.com. A key in a VITE_ variable is compiled
# into the bundle and served to every visitor — there is no way to call DeepSeek from the
# browser without publishing it. The route holds DEEPSEEK_API_KEY server-side and forwards.
# VITE_ARCHIS_API=/api/names
